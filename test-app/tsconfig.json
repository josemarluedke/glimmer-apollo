{
  "extends": "@ember/app-tsconfig/tsconfig.json",
  "include": [
    "app", "tests", "types"
  ],
  "compilerOptions": {
    "allowJs": true,
    /**
      https://www.typescriptlang.org/tsconfig#noEmitOnError
      Do not block emit on TS errors.
    */
    "noEmitOnError": false,

    "declaration": false,
    "declarationMap": false,

    /**
      https://www.typescriptlang.org/tsconfig#allowImportingTsExtensions

      We want our tooling to know how to resolve our custom files so the appropriate plugins
      can do the proper transformations on those files.
    */
    "allowImportingTsExtensions": true,

    /**
      @tsconfig/ember enabled this; its @ember/app-tsconfig successor does
      not. Kept to preserve the previous strictness.
    */
    "noPropertyAccessFromIndexSignature": true,

    "paths": {
      "test-app/tests/*": [
        "./tests/*"
      ],
      "test-app/*": [
        "./app/*"
      ],
      "*": [
        "./types/*"
      ]
    },
    "types": [
      "ember-source/types",
      "@glint/ember-tsc/types",
      "@embroider/core/virtual"
    ]
  },
}
